# Copy to .env.local and fill in. Never commit real values.

# --- Database ---
# One database for the app, migrations, seed and new logins. For the demo: Supabase → Connect →
# Connection string (drop the [ ] around the password; write @ in the password as %40).
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.YOURPROJECT.supabase.co:5432/postgres?sslmode=require

# Tests only: a LOCAL Postgres database whose name ends in _test (npm run db:setup creates it).
# Tests wipe data, so these must never point at Supabase; vitest refuses to start if they do.
DATABASE_URL_TEST=postgres://daybook_app:CHANGE_ME@localhost:5432/daybook_test
DATABASE_MIGRATION_URL_TEST=postgres://daybook_owner:CHANGE_ME@localhost:5432/daybook_test?sslmode=disable

# --- Razorpay (dashboard → Account & Settings → API Keys; use rzp_test_ keys locally) ---
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Set when creating the webhook (dashboard → Webhooks). Events: payment.authorized, payment.captured, payment.failed, order.paid, refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# --- Site ---
# Public origin, e.g. https://yoursalon.in (used for link-preview image URLs). Defaults to http://localhost:3000.
SITE_URL=

# --- Admin login (Better Auth) ---
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Uploads ---
# Where uploaded photos are stored on disk. Back this folder up with the database. Default: ./storage/uploads
UPLOAD_DIR=

# --- Email (SMTP) ---
# Hostinger mail: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465. Gmail: smtp.gmail.com, 465, with an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The "from" shown to recipients; must be allowed by the SMTP account.
EMAIL_FROM="Daybook <bookings@example.com>"
# Owner addresses for booking alerts (comma-separated).
OWNER_NOTIFY_EMAILS=
# Secret for the email retry cron on the VPS (openssl rand -hex 24). Leave empty to disable the endpoint.
CRON_SECRET=
# Sales demo only: "1" shows a demo strip on every page and test-payment hints. Never set for a real salon.
NEXT_PUBLIC_DEMO_MODE=
