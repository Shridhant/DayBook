# Copy to .env.local and fill in. Never commit real values.

# --- Database (PostgreSQL 18) ---
# App runtime role: can read/write rows, cannot change the schema.
DATABASE_URL=postgres://daybook_app:CHANGE_ME@localhost:5432/daybook
# Schema owner: used only by dbmate migrations and the dev seed.
DATABASE_MIGRATION_URL=postgres://daybook_owner:CHANGE_ME@localhost:5432/daybook?sslmode=disable
# Test database used by vitest (name must end in _test).
DATABASE_URL_TEST=postgres://daybook_app:CHANGE_ME@localhost:5432/daybook_test
DATABASE_MIGRATION_URL_TEST=postgres://daybook_owner:CHANGE_ME@localhost:5432/daybook_test?sslmode=disable

# --- Razorpay (dashboard → Account & Settings → API Keys; use rzp_test_ keys locally) ---
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Set when creating the webhook (dashboard → Webhooks). Events: payment.authorized, payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
